{
  "entities": {
    "Customer": {
      "title": "Customer",
      "description": "Customer contact and identity record for loan consultancy.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100, "minLength": 1 },
        "mobile": { "type": "string", "maxLength": 25, "minLength": 5 },
        "alternatePhone": { "type": "string", "maxLength": 25 },
        "email": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 300 },
        "city": { "type": "string", "maxLength": 100 },
        "employmentType": {
          "type": "string",
          "enum": ["Salaried", "Self-Employed / Business", "Professional (Doctor/CA/Lawyer)", "Trader / Merchant", "Other"]
        },
        "monthlyIncome": { "type": "number" },
        "panOrId": { "type": "string", "maxLength": 30 },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["name", "mobile", "employmentType"]
    },
    "Loan": {
      "title": "Loan",
      "description": "Loan schedule, tenure, bank commissions, and maturity record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 100 },
        "customerMobile": { "type": "string", "maxLength": 25 },
        "bankName": { "type": "string", "maxLength": 100 },
        "loanType": { "type": "string", "maxLength": 50 },
        "accountNumber": { "type": "string", "maxLength": 50 },
        "principalAmount": { "type": "number" },
        "interestRate": { "type": "number" },
        "tenureMonths": { "type": "number" },
        "emiAmount": { "type": "number" },
        "disbursalDate": { "type": "string", "maxLength": 50 },
        "maturityDate": { "type": "string", "maxLength": 50 },
        "bankCommissionPercent": { "type": "number" },
        "commissionAmount": { "type": "number" },
        "commissionStatus": { "type": "string", "enum": ["Pending", "Received"] },
        "status": { "type": "string", "enum": ["Active", "Near Maturity", "Completed", "Pre-Closed"] },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["customerId", "bankName", "principalAmount", "tenureMonths"]
    },
    "FollowUpLog": {
      "title": "FollowUpLog",
      "description": "Log entry tracking calls, inquiries, renewals, and reminders.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 100 },
        "loanId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 50 },
        "outcome": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 1000 },
        "nextFollowUpDate": { "type": "string", "maxLength": 50 },
        "agentName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["customerId", "outcome", "date"]
    }
  },
  "firestore": {
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Collection of all customer profiles and contact details."
    },
    "/loans/{loanId}": {
      "schema": "Loan",
      "description": "Collection of all active and past loan records."
    },
    "/followups/{followUpId}": {
      "schema": "FollowUpLog",
      "description": "Collection of all customer renewal and follow-up interaction records."
    }
  }
}
